# Токен бота, полученный от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Публичный HTTPS-адрес, на котором открывается mini app (без слеша на конце)
# Например: https://expenses.example.com
WEBAPP_URL=https://expenses.example.com

# Валюта по умолчанию для всех новых семейных чатов (просто отображается рядом с суммами)
DEFAULT_CURRENCY=RUB

# Путь до файла базы данных SQLite внутри контейнера (не менять, если используете docker-compose как есть)
DATABASE_PATH=/data/db/expenses.sqlite3

# Папка для хранения загруженных фото чеков внутри контейнера
PHOTOS_DIR=/data/photos

# Часовой пояс для планировщика повторяющихся трат (IANA-имя)
SCHEDULER_TIMEZONE=Europe/Moscow

# Порт, на котором слушает FastAPI внутри контейнера (проксируется через nginx/ваш reverse proxy)
API_PORT=8000

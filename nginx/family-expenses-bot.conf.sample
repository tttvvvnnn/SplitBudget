# Пример конфига для вашего существующего nginx на VPS.
# Telegram Mini App требует, чтобы приложение отдавалось по HTTPS с валидным сертификатом
# (самоподписанные не подходят). Проще всего получить сертификат через certbot (Let's Encrypt).
#
# Скопируйте это в /etc/nginx/sites-available/expenses.example.com.conf,
# поправьте домен и подключите certbot: certbot --nginx -d expenses.example.com

server {
    listen 80;
    server_name expenses.example.com;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # для загрузки фото чеков
        client_max_body_size 10m;
    }
}
